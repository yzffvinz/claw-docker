# ============================================
# OpenClaw Docker 部署配置
# ============================================
# 使用方法: cp .env.example .env && 编辑 .env 填入你的密钥
# 安全提醒: .env 包含敏感信息，已被 .gitignore 排除
# ============================================

# ==================== 必填项 ====================

# GitHub Copilot Token（copilot-api 用于访问 GitHub Copilot）
# 通过 copilot-api auth 流程生成（设备授权码登录，生成 ghu_ 前缀的 token）
# https://github.com/ericc-ch/copilot-api
COPILOT_PROXY_TOKEN=

# 飞书应用配置（从飞书开放平台获取）
# https://open.feishu.cn/app → 创建应用 → 获取 App ID 和 App Secret
FEISHU_APP_ID=
FEISHU_APP_SECRET=

# ==================== 自动生成项 ====================
# 如果未设置，OpenClaw 会自动生成 32 位随机字符串

# OpenClaw Gateway 认证 Token（控制台访问使用）
OPENCLAW_GATEWAY_TOKEN=

# ==================== 可选项 ====================

# OpenClaw Gateway 端口（默认 18789）
OPENCLAW_GATEWAY_PORT=18789

# ==================== 第三方集成 ====================

# Notion API Key（用于读写 Notion 页面/数据库）
# 获取: https://notion.so/my-integrations → 创建 Integration → 复制 API Key
# 注意: 需要在 Notion 中给目标页面授权此 Integration
NOTION_API_KEY=

# GitHub PAT（用于 workspace 自动备份到 GitHub）
# 获取: https://github.com/settings/tokens → Fine-grained token → 仅授权目标 repo
GITHUB_PAT=

# Brave Search API Key（用于 web_search 工具）
# 获取: https://brave.com/search/api/ → 注册 Free plan（每月 2000 次查询）
BRAVE_API_KEY=
