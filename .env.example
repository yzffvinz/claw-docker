# ============================================
# OpenClaw Docker 部署配置
# ============================================
# 使用方法: cp .env.example .env && 编辑 .env 填入你的密钥
# 安全提醒: .env 包含敏感信息，已被 .gitignore 排除
# ============================================

# ==================== 必填项 ====================

# GitHub Token（用于 copilot-proxy 访问 GitHub Copilot 模型）
# 获取: https://github.com/settings/tokens → 需要 copilot 权限
# 注意: 此 token 仅作为初始引导，实际使用时需通过 Web UI 生成 OAuth token
GITHUB_TOKEN=

# Copilot Proxy Token（copilot-proxy 实际使用的 OAuth token）
# 首次部署后通过 copilot-proxy Web UI 生成（SSH 隧道访问 localhost:3001）
# 格式: ghu_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
COPILOT_PROXY_TOKEN=

# Azure OpenAI 配置
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_MODEL=gpt-5.2

# 飞书应用配置（从飞书开放平台获取）
# https://open.feishu.cn/app → 创建应用 → 获取 App ID 和 App Secret
FEISHU_APP_ID=
FEISHU_APP_SECRET=

# ==================== 自动生成项 ====================
# 以下密钥由 start.sh 自动生成，无需手动填写
# 如果手动部署，请生成 32 位随机字符串填入

# LiteLLM API 网关密钥（OpenClaw 通过此密钥访问 LiteLLM）
LITELLM_MASTER_KEY=
# LiteLLM 加密盐值
LITELLM_SALT_KEY=
# PostgreSQL 密码
POSTGRES_PASSWORD=
# OpenClaw Gateway 认证 Token（控制台访问使用）
OPENCLAW_GATEWAY_TOKEN=

# ==================== 可选项 ====================

# OpenClaw Gateway 端口（默认 18789）
OPENCLAW_GATEWAY_PORT=18789

# ==================== 第三方集成 ====================

# Notion API Key（用于读写 Notion 页面/数据库）
# 获取: https://notion.so/my-integrations → 创建 Integration → 复制 API Key
# 注意: 需要在 Notion 中给目标页面授权此 Integration
NOTION_API_KEY=

# GitHub PAT（用于 workspace 自动备份到 GitHub）
# 获取: https://github.com/settings/tokens → Fine-grained token → 仅授权目标 repo
GITHUB_PAT=

# ==================== Embedding 模型 ====================

# Embedding API（用于 OpenClaw memory_search 向量检索）
# 需要一个支持 OpenAI 兼容 /v1/embeddings 端点的服务
# 模型: text-embedding-3-small
EMBEDDING_API_BASE=
EMBEDDING_API_KEY=
