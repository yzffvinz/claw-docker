# 确保脚本文件使用 LF 行尾符（Linux 标准）
*.sh text eol=lf

# 配置文件使用 LF
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.md text eol=lf
*.txt text eol=lf

# 环境变量文件使用 LF
.env* text eol=lf

# 其他文本文件使用 LF
*.conf text eol=lf
*.config text eol=lf

# 二进制文件不转换
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.jar binary
*.zip binary
*.tar.gz binary
*.tgz binary

# 数据目录中的文件保持原样
data/** -text
